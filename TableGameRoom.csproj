<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- installer/ 是独立的安装程序项目，不要编进主程序 -->
  <ItemGroup>
    <Compile Remove="installer/**" />
    <Page Remove="installer/**" />
    <None Remove="installer/**" />
    <ApplicationDefinition Remove="installer/**" />
    <Resource Remove="installer/**" />
  </ItemGroup>
</Project>
