<Window x:Class="TableGameRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TABLE | 虚拟美元游戏厅"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600">
    <!-- 自定义标题栏：WindowChrome 让客户区覆盖整个窗口，去掉系统 7px 白色边框/白线，
         同时保留边缘 6px 的窗口缩放热区。四角圆角由 RoundedCorners.Apply 调用 DWM 实现。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 标题栏按钮统一尺寸 46x42，内容为 10x10 矢量图标，图标与按钮均居中对齐 -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#35434C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#46555F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#9F2417"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#202A30" MouseLeftButtonDown="DragTitle">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinBtn" Style="{StaticResource TitleButton}" Click="Minimize"
                            AutomationProperties.Name="最小化" ToolTip="最小化">
                        <Viewbox Width="10" Height="10" Stretch="Uniform">
                            <Canvas Width="10" Height="10">
                                <Path Data="M0.5,5.5 L9.5,5.5" Stroke="White" StrokeThickness="1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Click="CloseWindow"
                            AutomationProperties.Name="关闭" ToolTip="关闭">
                        <Viewbox Width="10" Height="10" Stretch="Uniform">
                            <Canvas Width="10" Height="10">
                                <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="White" StrokeThickness="1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <TextBlock Text="TABLE | 虚拟美元游戏厅" Foreground="White" FontSize="16" FontWeight="Bold"
                           Margin="18,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Root" Grid.Row="1"/>
    </Grid>
</Window>
